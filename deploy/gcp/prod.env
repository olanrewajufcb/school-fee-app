# GCP Cloud Run Backend Deployment Environment Variables - PRODUCTION
# Usage: ./deploy/deploy-backend.sh prod

export ENVIRONMENT=prod
export GCP_PROJECT_ID=your-prod-project
export REGION=europe-west1
export IMAGE_TAG=latest

# Scaling configuration
export MIN_INSTANCES=1
export MAX_INSTANCES=10
export CONTAINER_CONCURRENCY=80

# Resources configuration
export CPU_LIMIT=2
export MEMORY_LIMIT=2Gi

# Database connection pool configuration
export R2DBC_POOL_INITIAL_SIZE=5
export R2DBC_POOL_MAX_SIZE=10

# Direct VPC egress and Cloud SQL private address
# NOTE: Set DB_HOST to the private IP assigned after creating Cloud SQL instance:
# gcloud sql instances describe edtech-db-prod --format="value(ipAddresses[0].ipAddress)"
export VPC_NETWORK=edtech-prod
export VPC_SUBNET=edtech-cloudrun-prod
export DB_INSTANCE=edtech-db-prod
export DB_HOST=10.0.0.4
export DB_NAME=edtech
export DB_USER=sch_fee_user

# URL configs
export BACKEND_URL=https://api.smartbridgeedu.com
export FRONTEND_URL=https://smartbridgeedu.com
export CORS_ALLOWED_ORIGINS=https://smartbridgeedu.com

# Identity Provider (Keycloak) Configuration
export KEYCLOAK_URL=https://auth.smartbridgeedu.com
export KEYCLOAK_REALM=edtech
export KEYCLOAK_ISSUER_URI=https://auth.smartbridgeedu.com/realms/edtech
export KEYCLOAK_JWK_SET_URI=https://auth.smartbridgeedu.com/realms/edtech/protocol/openid-connect/certs
export KEYCLOAK_ADMIN_USER=superadmin
export KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# SMTP Configuration
export MAIL_HOST=smtp.resend.com
export MAIL_PORT=587
export MAIL_FROM=noreply@smartbridgeedu.com
export MAIL_SMTP_AUTH=true
export MAIL_SMTP_STARTTLS=true

# Notification Features toggles
export SMS_ENABLED=true
export WHATSAPP_ENABLED=true
