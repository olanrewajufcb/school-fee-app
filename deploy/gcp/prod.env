# GCP Cloud Run Backend Deployment Environment Variables - PRODUCTION
# Usage: source deploy/gcp/prod.env && envsubst < deploy/gcp/cloud-run-backend.yaml | gcloud run services replace - --region "$REGION"

export ENVIRONMENT=prod
export GCP_PROJECT_ID=your-prod-project
export GCP_PROJECT_NUMBER=your-prod-project-number
export REGION=europe-west1
export IMAGE_TAG=latest

# Scaling configuration
export MIN_INSTANCES=1
export MAX_INSTANCES=10
export CONTAINER_CONCURRENCY=80

# Resources configuration
export CPU_LIMIT=2
export MEMORY_LIMIT=2Gi

# Database connection pool configuration
export R2DBC_POOL_INITIAL_SIZE=5
export R2DBC_POOL_MAX_SIZE=10

# Direct VPC egress and Cloud SQL private address
export VPC_NETWORK=schoolfee-prod
export VPC_SUBNET=schoolfee-cloudrun-prod
export DB_HOST=10.0.0.4

# URL configs
export BACKEND_URL=https://api.your-domain.com
export FRONTEND_URL=https://schoolfee.app
export CORS_ALLOWED_ORIGINS=https://schoolfee.app

# Identity Provider (Keycloak) Configuration
export KEYCLOAK_URL=https://auth.your-domain.com
export KEYCLOAK_ISSUER_URI=https://auth.your-domain.com/realms/schoolfee
export KEYCLOAK_JWK_SET_URI=https://auth.your-domain.com/realms/schoolfee/protocol/openid-connect/certs
export KEYCLOAK_ADMIN_USER=superadmin

# SMTP Configuration
export MAIL_HOST=smtp.example.com
export MAIL_PORT=587
export MAIL_SMTP_AUTH=true
export MAIL_SMTP_STARTTLS=true

# Notification Features toggles
export SMS_ENABLED=true
export WHATSAPP_ENABLED=true
