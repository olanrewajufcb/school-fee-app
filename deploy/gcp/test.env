# GCP Cloud Run Backend Deployment Environment Variables - TEST
# Usage: ./deploy/deploy-backend.sh test

export ENVIRONMENT=test
export GCP_PROJECT_ID=edtech-project-510010
export GCP_PROJECT_NUMBER=84029820822
export REGION=europe-west1
export IMAGE_TAG=latest

# Scaling configuration
export MIN_INSTANCES=1
export MAX_INSTANCES=5
export CONTAINER_CONCURRENCY=40

# Resources configuration
export CPU_LIMIT=1
export MEMORY_LIMIT=1Gi

# Database connection pool configuration
export R2DBC_POOL_INITIAL_SIZE=2
export R2DBC_POOL_MAX_SIZE=5

# Direct VPC egress and Cloud SQL private address
# NOTE: Set DB_HOST to the private IP assigned after creating Cloud SQL instance:
# gcloud sql instances describe edtech-db-test --format="value(ipAddresses[0].ipAddress)"
export VPC_NETWORK=edtech-test
export VPC_SUBNET=edtech-cloudrun-test
export DB_INSTANCE=edtech-db-test
export DB_HOST=10.0.0.3
export DB_NAME=edtech
export DB_USER=sch_fee_user

# URL configs
export BACKEND_URL=https://api-test.smartbridgeedu.com
export FRONTEND_URL=https://test.smartbridgeedu.com
export CORS_ALLOWED_ORIGINS=https://test.smartbridgeedu.com

# Identity Provider (Keycloak) Configuration
export KEYCLOAK_URL=https://auth-test.smartbridgeedu.com
export KEYCLOAK_REALM=edtech
export KEYCLOAK_ISSUER_URI=https://auth-test.smartbridgeedu.com/realms/edtech
export KEYCLOAK_JWK_SET_URI=https://auth-test.smartbridgeedu.com/realms/edtech/protocol/openid-connect/certs
export KEYCLOAK_ADMIN_USER=superadmin
export KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# SMTP Configuration
export MAIL_HOST=smtp.resend.com
export MAIL_PORT=587
export MAIL_FROM=noreply@smartbridgeedu.com
export MAIL_SMTP_AUTH=true
export MAIL_SMTP_STARTTLS=true

# Notification Features toggles
export SMS_ENABLED=false
export WHATSAPP_ENABLED=false
