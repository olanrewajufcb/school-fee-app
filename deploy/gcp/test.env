# GCP Cloud Run Backend Deployment Environment Variables - TEST
# Usage: source deploy/gcp/test.env && envsubst < deploy/gcp/cloud-run-backend.yaml | gcloud run services replace - --region "$REGION"

export ENVIRONMENT=test
export GCP_PROJECT_ID=your-test-project
export GCP_PROJECT_NUMBER=your-test-project-number
export REGION=europe-west1
export IMAGE_TAG=latest

# Scaling configuration
export MIN_INSTANCES=1
export MAX_INSTANCES=5
export CONTAINER_CONCURRENCY=40

# Resources configuration
export CPU_LIMIT=1
export MEMORY_LIMIT=1Gi

# Database connection pool configuration
export R2DBC_POOL_INITIAL_SIZE=2
export R2DBC_POOL_MAX_SIZE=5

# Direct VPC egress and Cloud SQL private address
export VPC_NETWORK=schoolfee-test
export VPC_SUBNET=schoolfee-cloudrun-test
export DB_HOST=10.0.0.3

# URL configs
export BACKEND_URL=https://api-test.your-domain.com
export FRONTEND_URL=https://schoolfee-test.vercel.app
export CORS_ALLOWED_ORIGINS=https://schoolfee-test.vercel.app,http://localhost:5173,http://localhost:3000

# Identity Provider (Keycloak) Configuration
export KEYCLOAK_URL=https://auth-test.your-domain.com
export KEYCLOAK_ISSUER_URI=https://auth-test.your-domain.com/realms/schoolfee
export KEYCLOAK_JWK_SET_URI=https://auth-test.your-domain.com/realms/schoolfee/protocol/openid-connect/certs
export KEYCLOAK_ADMIN_USER=superadmin

# SMTP Configuration
export MAIL_HOST=smtp.example.com
export MAIL_PORT=587
export MAIL_SMTP_AUTH=true
export MAIL_SMTP_STARTTLS=true

# Notification Features toggles
export SMS_ENABLED=false
export WHATSAPP_ENABLED=false
